{
  "name": "vscode-todl",
  "displayName": "vscode-todl",
  "description": "VSCode Extension for Todl",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:todl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "todl",
        "aliases": [
          "todl"
        ],
        "extensions": [
          ".tdl"
        ]
      }
    ],
    "grammars": [
      {
        "language": "todl",
        "scopeName": "source.todl",
        "path": "./syntaxes/todl.tmLanguage.json"
      }
    ],
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "resolutions": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.7"
  },
  "packageManager": "yarn@4.3.1+sha512.af78262d7d125afbfeed740602ace8c5e4405cd7f4735c08feb327286b2fdb2390fbca01589bfd1f50b1240548b74806767f5a063c94b67e431aabd0d86f7774"
}
