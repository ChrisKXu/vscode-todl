{
  "name": "todl",
  "scopeName": "source.todl",
  "fileTypes": [
    "tdl"
  ],
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.n",
          "match": "\\b(if|unless|while|until|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.n",
          "match": "\\b(const|let)\\b"
        },
        {
          "name": "keyword.import.n",
          "match": "\\b(import|from)\\b"
        },
        {
          "name": "keyword.type.n",
          "match": "\\b(bool|byte|char|int|long|string|void)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.n",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.n",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.n",
      "match": "\\b\\d+\\b"
    }
  }
}